# Tavily API Key for searching the web
TAVILY_API_KEY=

# Ollama Cloud LLM (main model for synthesis)
OLLAMA_API_KEY=
OLLAMA_API_BASE=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b-cloud

# Sub-agent LLM (smaller model for paper analysis & diagram generation)
# Leave OLLAMA_SUB_MODEL empty to use the main model for all agents
OLLAMA_SUB_MODEL=
OLLAMA_SUB_API_BASE=http://localhost:11434/v1
OLLAMA_SUB_API_KEY=ollama

# Base URL for absolute image URLs in API responses
API_BASE_URL=http://localhost:8000