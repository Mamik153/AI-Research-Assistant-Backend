# Tavily API Key for searching the web
TAVILY_API_KEY=

# API key for research endpoints (required). Send as Authorization: Bearer <key> or X-API-Key: <key>
API_KEY=

# Optional: max concurrent research jobs (default 1). Reject new submissions with 503 when at capacity.
# MAX_CONCURRENT_RESEARCH_JOBS=1

# Optional: rate limit per client, requests per minute (default 10).
# RATE_LIMIT_PER_MINUTE=10

# Ollama Cloud LLM (main model for synthesis)
OLLAMA_API_KEY=
OLLAMA_API_BASE=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b-cloud

# Sub-agent LLM (smaller model for paper analysis & diagram generation)
# Leave OLLAMA_SUB_MODEL empty to use the main model for all agents
OLLAMA_SUB_MODEL=ministral-3:3b
OLLAMA_SUB_API_BASE=https://ollama.com/v1
OLLAMA_SUB_API_KEY=ollama

# Supabase (required for vector store and file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=research-assets

# PageIndex hybrid retrieval (optional, enhances retrieval quality)
PAGEINDEX_ENABLED=false
PAGEINDEX_MODE=self_hosted
PAGEINDEX_API_KEY=
PAGEINDEX_MODEL=
PAGEINDEX_MAX_TREE_PAPERS=3